# ==========================================
# DRONE FLEET AI - GITHUB GITIGNORE
# Prevents large, generated, or secret files
# ==========================================

# Virtual Environments (DO NOT UPLOAD TO GITHUB)
venv/
*/venv/
env/
*/env/
ENV/
.venv/
*/.venv/

# Node Dependencies & Builds (DO NOT UPLOAD TO GITHUB)
node_modules/
*/node_modules/
build/
*/build/
!frontend/build/
!frontend/build/**
dist/
*/dist/
.pnp
.pnp.js

# Python Bytecode & Cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyd.disabled
*.so
.Python

# SQLite Databases & Local Storage
*.db
*.sqlite
*.sqlite3
backend/drone_fleet.db

# Environment & Secret Files
.env
*.env
!.env.example
*.pem
*.key

# Logs & Temporary Files
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server.log
stdout.log
stderr.log

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
